# Compose binds HTTP to loopback by default. A reverse proxy on the Docker
# host can use 127.0.0.1:8080; a proxy container should share a Docker network
# and use kindle-bridge:8080 instead.
KINDLE_BRIDGE_BIND_ADDRESS=127.0.0.1
KINDLE_BRIDGE_HTTP_PORT=8080

# Use the exact public HTTPS origin and Host seen by the browser/proxy.
# Do not use * and do not add a trailing slash to the origin.
CATALOG_ALLOWED_ORIGINS=https://kindle-bridge.home.arpa
# Keep the exact loopback authority for the in-container readiness probe.
CATALOG_ALLOWED_HOSTS=127.0.0.1:8080,kindle-bridge.home.arpa
CATALOG_REQUIRE_ORIGIN=true

# The host makes local or network-backed storage available before Docker
# starts. Kindle Bridge sees only this read-only container mount.
KINDLE_BRIDGE_LIBRARY_HOST_PATH=/srv/ebooks

# Named volumes make backup/restore and rollback explicit.
KINDLE_BRIDGE_DATA_VOLUME=kindle-bridge-data
KINDLE_BRIDGE_CACHE_VOLUME=kindle-bridge-cache

# Leave writable for initial configuration; lock after setup if desired.
CATALOG_SETTINGS_MODE=read-write

# Bounded defaults. Raise only after a measured household load test.
CATALOG_MAX_BODY_BYTES=1048576
CATALOG_MAX_CONCURRENT=64
CATALOG_MAX_SOURCE_STREAMS=4
# Bound a complete source response, including NAS validation, snapshotting, and client delivery.
CATALOG_SOURCE_RESPONSE_TIMEOUT_MS=600000
# Bound derived-cover reads so a stalled cache cannot occupy response capacity indefinitely.
CATALOG_COVER_RESPONSE_TIMEOUT_MS=30000
# Bound Settings checks against configured source paths and startup validation of /libraries.
CATALOG_SETTINGS_VALIDATION_TIMEOUT_MS=10000
CATALOG_ROOT_POLICY_TIMEOUT_MS=10000
CATALOG_RATE_PER_MINUTE=600
CATALOG_SHUTDOWN_TIMEOUT_MS=20000
CATALOG_QUIET_WINDOW_MS=750
# A changed file must remain unchanged for this long before it is indexed.
CATALOG_STABILITY_WINDOW_MS=2000
CATALOG_MAX_CONCURRENT_SCANS=2
# One active root scan may run for at most ten minutes before a durable retry is deferred.
CATALOG_SCAN_TIMEOUT_MS=600000
CATALOG_MAX_SCAN_ENTRIES=1000000
CATALOG_MAX_SCAN_DIRECTORIES=50000
CATALOG_METADATA_WORKERS=2
CATALOG_METADATA_TIMEOUT_MS=15000
CATALOG_RECONCILE_MS=900000
# Successful per-root completion is durable in SQLite; restarts do not reset this deadline.
CATALOG_DEEP_RECONCILE_MS=86400000
CATALOG_COVER_RETENTION_MS=604800000
CATALOG_COVER_PRUNE_MS=86400000

# Prefer an immutable release digest in production.
KINDLE_BRIDGE_IMAGE=kindle-bridge:local
